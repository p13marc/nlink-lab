# VXLAN ovmgmte# Spine-leaf (provide
lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

# Leaves
node leaf1 : router {
  lo 10.255.1.1/32
  route default via 10.0.11.1
}
node leaf2 : router {
  lo 10.255.1.2/321  route default }

# Impairments
impair *pine1:eth10 "engineering"
  port host1 { pvid 100  untaggeth VLAd  jitter 1mN strda
