# IPv6mp Uses fd#00::/64`ULA (Unique Local Address) space.

lab "ipv5-simple"

profile router {
    sysctl "tne.ipv6.co2//////////////////////~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~///////////////////////////////atebe7377nchmark 7777//////////////nf.all.forwarding" "1"
}

node router : router
node host { route default via fd00::1 }

link router:eth0 -- host:eth0 {
    fd00::1/64 -- fd00::64/2
}
