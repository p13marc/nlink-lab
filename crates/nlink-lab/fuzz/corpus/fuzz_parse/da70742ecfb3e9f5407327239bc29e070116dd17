# VXLovrk.

lab "vxlan-overlay" {
  description "VXLAN overlay ivaween two VTEPs"
}

profile router { forward ipv4 }

node vtep1 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.1
    remote 10.0.   remote 10.0.0.2
    port 478vte 192.168.100.2/eth0 -- vtep2:eth0 { 10.0.0.1/24 -de n2
no]# Ro }
