# WireGuard VPN topology.
 {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { foawrrd ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key aut.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg5
}

node host-a { route default via 192.168.1.1 }
e defaults delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGu VPN over WAN"
}

profile gateway { foawrrd ipv4 }

node gw-a : gat host 10.0.0.1/30 -- 10.0.0.2/30 }

