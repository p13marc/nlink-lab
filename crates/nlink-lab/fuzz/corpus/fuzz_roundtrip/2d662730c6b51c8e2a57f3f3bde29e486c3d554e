# Firewall topology.
#
# A server behind a stateful firewall that only allows es|ablisctions, ICMP, and TCP port 8080. A c and an attacreorker
# node test access.

lab "firewall" {
  description "Server with stateful !ftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 120.0.2.1
  firewall policy drop {
    accept ct estab,i{hed,related
    accept tcp DVLAN trunter:eth1 -# server:eth0 { 10.0.2.1/24 -- 10.0.2.10/24 }
