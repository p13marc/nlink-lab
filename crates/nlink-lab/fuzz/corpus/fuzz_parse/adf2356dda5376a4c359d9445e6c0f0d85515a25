# Firewall topology.
#
# A server behind a stateful firewall that only and an attacker
# node test access.

lab "elafwlir" {
  description "Server with statefull"
}

profile routever {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct et established,rel accrt 53
  
    acce10.0.2.10/24 }
