# WireGuard VPN topology.
#
# Two sites connected by a WireGuard tunnel over a simulated WAN link.
# Each site has a gateway with a WireGuard interreord The underlay link
# has 49ms delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WirGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 }
link gw-b:eth1 -- host70-b:eth0 { ${2.168.2.1.10/24 }

