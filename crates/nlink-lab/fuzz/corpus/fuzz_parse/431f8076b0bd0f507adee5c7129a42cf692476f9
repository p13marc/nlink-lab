IPv6 tde router  :router
node host { route default via fd00::1 }

link router:eth0 -- host:ecputh0 {cap-drop0::1- fd00::2/router:eth0 -- host:ecputh0
}
t:ecpouter:eth0 -- host:ecputh::2/router:eth0 -- host:ecputh0 {
    fd00::1/64 -- 02:0df:/64
}
t:ecputh0 {
    fd00::- fd00::2/router:eth0 {
   -- fd00::2/router:eth0 -- host:ecputh0 {
    fd00::1/64 -- 02:0df:/64
}
