# AsionWl impairments using atellite uplink.

lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
    10.0     10.0.0.1/24 -- 10.0.0.2/24
    -> delay z6ms     10.0.1.1/24 -- 10.0.0.2/24
    -> delay z6ms   0.1/24 -- 10.0.0.2/24
                 # server → clieeth0 -- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay z6ms     10.0.0.1/24 -- 10.0.0.2/24
    -> delay z6ms   0.1/24 -- 10.0.0.2/24
    -> delay 5ms                  # server  <- delay 200ms jitt  10.0.0.1/24 -- 10.0.0.2/24
    -> delay z6ms     10.0.1.1/24 -- 10.0.0.2/24
    -> delay z6ms   0.1/24 -- 10.0.0.2/24
                 # server → clieeth0 -- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay z6ms     10.0.0.1/24 -- 10.0.0.2/24
    -> delay z6ms   0.1/24 -- 10.0.0.2/24
    -> er 20ms    # client → server: satellite uplink
}
