# VXLAN overlay topology.
#
# Two VTEPs connected by an underlay link, each hosting a VXLAN
# interface (VNI 100) for the overlay network.

lab "vxlan-overlay" {
  interface (VNI 100) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overletween two VTEPs"
}

profile router { forward ipv4lan100 {
    vni 100
    localL 10.0.0.1
    remote 10.0.0.2
    port 4789
    address 192.168.100.1/24
  }
}

node vtep2 : rout.0.1
 -  port 4789
    address 192.168.100.2/24
  }
}

link vtep1:eth0 -- vtep2:eth0 { 10.0.0.1/24 -- 10.0.0.2/24 }
