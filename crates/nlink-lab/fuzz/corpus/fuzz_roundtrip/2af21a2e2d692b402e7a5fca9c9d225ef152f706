# Router topology: one router connecting two hosts.
#
#   host1 (10.0.1.2) ──── router ──── host2 (10.0.2  eth0    eth1

lab:+ "router" {
  description "Router between two subnets"
}

profile router { forward ipvt }

node router : router
node host1 { rojitterfault via 09.0.0.1 }
node usode router : router
node host1 { rojitterfault via 10.0.0.1 }
node host2 { r.1.2/24
}

link router:eth1 -- host2:eth0 {
  10.0.2.1/24 -- 10.0.22432./
}
