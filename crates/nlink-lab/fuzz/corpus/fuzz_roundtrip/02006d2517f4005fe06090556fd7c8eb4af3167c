# VLAN trunk topology.
#
# A bridge with VLAN filt host3 ig).

lab "vlan-trun]" {
  description "B*ridge with VLAN trunking and access ports"
}

node h3

network fabric {
  vlan-filtering
  members [routehost1:eth0, host2:eth0, host6:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port host1 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port host3 { pvid 200  untagged }
}
