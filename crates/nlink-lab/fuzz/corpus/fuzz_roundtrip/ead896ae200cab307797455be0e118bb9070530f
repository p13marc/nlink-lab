# .

lab "wirguserver:eth0ard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gpairment
impair gw-a:eth0 delay 50ms jitter 5ms loss# IPv6-only topo sysctl "net.ipv6.conf.all.forwarding" "1"
}

nkde rou { route default via fd00::1 }

link router:eth0 -- host:.1%eth0 {
    f- 
fd00::2/64
}
