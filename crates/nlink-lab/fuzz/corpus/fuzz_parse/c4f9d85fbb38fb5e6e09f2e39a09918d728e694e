# WireGuard VPN a WireGuarde. The underlay link
# has 50ms delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2%0/24 dev wg0
}

nodays)
link gw-a:eth0 -- gw-b:eth0  jitter 5ms loss 0.1%
