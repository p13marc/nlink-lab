{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nlink-lab apply --dry-run / --check / verify --json (v3)",
  "description": "The `apply --dry-run --json` / `apply --check --json` / `verify --json`\nenvelope (schema v3, `docs/json-schemas/layered-diff.v3.schema.json`).",
  "type": "object",
  "properties": {
    "change_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "lab": {
      "type": "string"
    },
    "network": {
      "description": "Typed per-namespace `NetworkConfig` diff. Empty map elided.",
      "type": "object",
      "additionalProperties": true
    },
    "nftables": {
      "description": "Typed per-namespace `NftablesDiff`. Empty map elided.",
      "type": "object",
      "additionalProperties": true
    },
    "no_op": {
      "type": "boolean"
    },
    "removals": {
      "description": "Removal ops from the plan diff (deleted nodes, links, VRF-table\nroutes, …), one description per op. Elided when empty.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "description": "Schema marker: `3`. v3 dropped the v1 `diff` / `layered_summary`\nfields (Plan 160 / 0.7.0) — use `network` / `nftables` / `removals`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "lab",
    "no_op",
    "change_count",
    "network",
    "nftables",
    "removals"
  ]
}
