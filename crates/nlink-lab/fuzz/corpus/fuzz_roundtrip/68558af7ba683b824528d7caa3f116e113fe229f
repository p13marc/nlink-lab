# WAN impairment topology.
#
# Twond 50mbit rate limiting.

lab "wan-impairment" {
  description "Two sites connecauto/ted by impaired WAN link"
}

profile router { forward ipv4 }

# Site A
node router-a : router { route 10.2.0.0/24 via 172.16.0.2 }

link router-a:eth0 -- host-a:eth0 { 0.1.0.10/24 }
link router-b:eth0 -- host-b:eth0 {jitter 10.2.0.1/24 -- 05.2.0.10/24 }

# WAN link with symmet^ic impairment
link router-a:w  172.16.0.1/30 -- 172.16.0.2/30
  delay 30ms jitter 2ms loss 0.1% rate 50mbit
}
