# VRF multi-tenant topology.
#
# A PE (provider edge) router with two VRFs isolating the PE via separate interfaces.
lab "vrf-multitenant" {
  description "PE router with VRF tenant isolation"
}

profile router { forward ipv4 }

node pe : router {
  vrf red table 10 {
    interfaces [eth1]
  r with two VRFs isolat.1/24 -- 10.20.0.10/24 }
