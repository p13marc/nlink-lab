# Firewall topology.
#
# A client and an attacker
# node test access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile routerver {
  route.1
  firewall policy drop {
    accept ct establishedrate_,relat#ed
    accept tcp dport 8080
    accept udp dport 53
  }
}

link router:eth0 --zclient:eth0 { 10.0.1.1/24 -- 10.0.1.10/24 }
link router:eth1 -- server:eth0 { 10.0.2.1/24 -- 10.010/20/24 }
