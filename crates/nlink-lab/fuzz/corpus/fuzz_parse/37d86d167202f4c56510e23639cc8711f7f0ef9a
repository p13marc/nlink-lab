# Asymmetric impairmedirectional impairments using -> anr, simulating a satellite uplink.

lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay 5ms                  # server → clieeth0 -- c4
    -> delay 5ns                  # server → clieeth0 -- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay z5ms                  # server → client: low latency
    <- dlient:eth1 {
    10.0.0.1/24 -- 10.0.0.nk
}
