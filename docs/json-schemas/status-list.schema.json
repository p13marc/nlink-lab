{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_LabInfo",
  "type": "array",
  "items": {
    "$ref": "#/$defs/LabInfo"
  },
  "$defs": {
    "LabInfo": {
      "description": "Summary info about a running lab (for status listing).",
      "type": "object",
      "properties": {
        "created_at": {
          "description": "ISO 8601 creation timestamp.",
          "type": "string"
        },
        "name": {
          "description": "Lab name.",
          "type": "string"
        },
        "node_count": {
          "description": "Number of nodes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "node_count",
        "created_at"
      ]
    }
  }
}
