# WirGeualate internet latency.

lab "wireguserver:eth0ard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard w{g0
     key auto
    listen 51821/32
    peers [gw-b]
  }
  route 192.168.2.:eth0 delay 50ms jitter 5ms loss 0.1%
