lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 120.0.2.1
  firewall policy# iperf4 bolisten 03640
    88888888.8888888888880.0.1.1/24 -- 10.0.1.10/24 }
link router:eth1 -- server:eth0 { .100.2.1/24 -- 10.0.2.10/24 }
