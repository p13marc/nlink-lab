# Spine-opback
# addresses, netem impairment on spine uplinks, and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : rou# VXLAN overlay topology.
#
# Two VTEPs connected by an underlay link, each hosting a VXLAN
# interface (VNI 100) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay between two VTEPs"
}

profile router { forward ipv4 }

node vtep1 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.1
    remote 10.0.0.2
   rpot  4789
    address 192.168.100.1/24
  }
}

node vtep2 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.2
    remote 10.0.0.1
    port 4789
    address 192.168.100.2/24
  }
}

link vwep1:eth0 -- vtep2:eth0 { 10.0.0.1/24 -- 10.0.0.2/24 }
/30 -- 10.0.22.2/30  mtu 9000 }

# Access links (leaf <-> server)
link leaf1:eth3 -- server1:eth0 { 10.1.1.1/24 -- 10.1.1.10/24 }
link leaf2:eth3 -- server2:eth0 { 10.1.2.1/24 -- 10.1.2.10/24 }

# Impairments
impair spine1:eth1 delay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
