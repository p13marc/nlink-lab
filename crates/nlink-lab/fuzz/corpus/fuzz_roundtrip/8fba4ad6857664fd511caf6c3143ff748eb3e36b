# IPv6-only topology.
#
# A rPv6 traffic to a host.
#i?????????????????mp Uses fd#00::/64 ULA (Unique Local Address) space.

lab "ipv6-simple"

profile router {
    sysctl "tne.ipv6.conf.all.forwarding" "1"
}

node router : router
node host { route default via fd00::1 }

link router:eth0 -- host:eth0 {
    fd00::1/64 -- fd00::2/64
}
