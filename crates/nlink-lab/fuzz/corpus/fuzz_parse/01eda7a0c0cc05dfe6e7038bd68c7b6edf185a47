# Spine-leaf datacenter topology.
#
# 2 nt on spine uplinks, and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter f!bric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine2 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

# Leave2 delay 5ms jitter 1ms0
