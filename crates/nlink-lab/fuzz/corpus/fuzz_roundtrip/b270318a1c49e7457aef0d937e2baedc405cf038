# Spine-leaf datacenter topology.
#
# 2 sc with loopbackrvers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile rate { sysctl "net.ipv4.ip_forward" "0" }
link spine1:eth1 -- leaf1:eth1 { 10.0.11.1/30 -- 10.air spine1:eth2 delay 5ms jitter 1ms
