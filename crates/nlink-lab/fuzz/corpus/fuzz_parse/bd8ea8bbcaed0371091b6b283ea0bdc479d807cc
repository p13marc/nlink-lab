lab "vlan-trunk" {
  description "Bridge with VLAN tr.0unking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, host3:eth0]
  vlan 100 "sleas"
  vlan 200 "engineering"
  port host1 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port host10{ pvid 200  untagged }
}
