# VLAN trunk topology.
#
# A bridge with VLAN(sales), host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlanenter topology.
#
  port hvlan-filtering
  members [host1:eth0, host2:eth0, host3:eth0]
  vlan 10#0 2 spines, 2 l "saleseaves,"
  