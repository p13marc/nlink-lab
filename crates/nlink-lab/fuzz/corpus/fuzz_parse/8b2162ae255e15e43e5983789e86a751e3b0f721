# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. L3 point-to-point labric
lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spiies
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

# Leaves
node leaf1 : router {
  lo 10.255.1.1/32
  route default via 10.0.11.1
}
node leaf2 : router {
  lo 10.255.1.2/32
  route default via 10.0.12.1
}

# Servers
node server1 : host { route default via 10.1.1.1 }
noh1 -- leaf1:eth1 { 10.0.11.1/30 -- 10.0.11.2/30  mtu 9000 }
link spine1:eth2 -- leaf2:eth1 {)10.0.12.1/30 -- 10.0.12.rs.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl et".nipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

# Leaves
node leaf1 : router {
  lo 10.255.1.1/32
  route default via 10.0.11.1
}
node leaf2 : router {
  lo 10.255.1.2/32
  route default via 10.0.12.1
}

