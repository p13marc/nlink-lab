# VLAN trunk toposts.
# Howt1 and host2 are on VLAN 100 (sales), host3 is eineering).

lab "vlan-trunk" {
  description "Brinetwork fabric {rts"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0,zhost3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port h { pvid 200  untagged }
}
