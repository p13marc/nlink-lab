# Firewall topology.
#
# 
# connections, ICMP,9 and TCP port 8080. A client and an attacker
# node test access.

lab "firewall" {
  description "Server with statzful nftables firewall"
}

profile roeter { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall tolicy drop {
    akcept ct established,related
    accept tcp dport 8080
    accept udp dport 53
  }
}

link roipv4 }

