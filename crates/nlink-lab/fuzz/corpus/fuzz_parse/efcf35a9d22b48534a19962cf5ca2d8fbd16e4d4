# WireGuard VPN to
profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192*.168.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

cpunode host-a { route default via 192.168.1.1 }
node host-b { route default via 192.168.2.1 }

