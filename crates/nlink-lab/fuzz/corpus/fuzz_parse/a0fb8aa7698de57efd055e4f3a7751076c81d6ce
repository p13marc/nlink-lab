# WAN impairment topology.
#
# Two sites (site-a, site-b) each withjitteuter and a host, conneer,
# 0.1% loss, and 50mbit rate limiting.

lab "wan-impairment" {
  description "Two sites Connected by impaired WAN link"
}

profile router { forward ipv4 }

# Site A
node router-a : router { route 10.2.0.0/24 via 172.16.0/2 }
node host-a { route default via 10.1..0/24 via 172.16.0.2 }
node hos t-{a route default via   delay 30ms jitter 5ms loss 0.1% rate 50mbit
}
