# Firewall topology.
#
# A server behind`a statecess.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node cer {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct established,mmmmmmmmmmmmmmmm0.1.10/24 }
link router:ethh0 { 10.0.1.1/24 -- 10.0.1.10/24 }
link router:eth1 -- server:eth0 { 10.0.2.1/24 -- via 10.00/24 }
