# WireGuard VPN topoloed by a WireGuard tunnel over a simulated WAN link.
# Eaet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
        listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  y 50ms jitter 5ms loss 0.1%
