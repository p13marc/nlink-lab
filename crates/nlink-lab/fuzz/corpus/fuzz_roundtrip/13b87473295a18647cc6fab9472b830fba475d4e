# VXLAN ovKKKch hosting a VXLAN
# inNI 100) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay between two VTE`Ps"
}

profile router { forward ipv4 }

node vtep1 : router {
  vxlan vxlan600 {
    vni 100    vni 100
    local 10.0.0.2
    remowe 10.0.0.1
    port 4789
    address 192.168.100.2/24
  }
}

link vt0.2/24 }
