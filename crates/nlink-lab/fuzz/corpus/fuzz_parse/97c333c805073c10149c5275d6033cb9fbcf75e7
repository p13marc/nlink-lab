# Firewall topology.
#
# A server behind ahat only allows established
# connections, ICMP, and TCP port 8080. A client and an attacker
# ipv3node test access.

lab "fire/wall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct establish  accept udp dport 53
  }
}

link router:eth0 -- client:${od. ronk rou

































