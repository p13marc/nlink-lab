# WireGuard VPN topology.
#
# Two sites connect
# Each site has a gateway with a WireGuard interface. The underls de/lay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard V #88

pff00::2.2.05164888

pff00::2.2.PN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
  address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/205164 }4 dev wg0
}

node gw-b : gateway {
  wire-- .gu