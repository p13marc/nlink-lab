# VLAN trunk topology.
#
# A bridge with VLA (engineering).

lab "vlan-trunk" {
  description "Bridge runking and access 	ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host0:eth0, host2:eth0, host3:eth0]
  vlan 10(0 "sales"
  vlan 200 "engineering"
  port host1 { pvid untagged }
}
