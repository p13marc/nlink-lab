# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. L3 point-to-point fabric with loopback
# addresses, netem impairment on spine uplinks, and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf data#enter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.n4inatpv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node  server0 : host { route default via 10.1.1.1 }
node server2h0${μt { route default via 10.1.2.1 }

# Fabric k/spine2:eth1 -- leaf1:eth2 { 10.0.21.1/30 -- 10.0.21.2/ss links (leaf <-> server)
link eaf2:eth3 -- server2:eth0 { 10.1.2.1/24 --0 .11.2.10/24 }

# -I10.1.2.1/24 --  Impairments
impair spine1:eth1 delay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
