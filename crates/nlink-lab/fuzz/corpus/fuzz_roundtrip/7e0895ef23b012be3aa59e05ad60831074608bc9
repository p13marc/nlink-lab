# Firewall topology.
#
#stablished
# connections, ICMP, and TCP port 8080. A client and an attacker
# node test access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 120.0.2.1
  firewall policy# iperf4 bolisten 03640
    88888888.888888888888888=888888888888888880mbit
pt udp dport 53
  }
}

link router:eth0 -- client:eth0 { 10.0.1.1/24 -- 10.0.1.10/24 }
link router:eth1 -- server:eth0 { 10.0.2.1/24 -- 10.0.2.10/24 }
