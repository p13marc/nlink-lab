# iperf3 benchmark tok-lab exec iperf-bench c,ient -- iperf3 -c 10.0.0.1 -t 5

lab "iperf-bench" {
  description "Two nohput benchmng"
}

node server { route default }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 { 10.0.0.1/24 -- 10.0.0.2/24 }

rate server:eth0 egres
  de benod3ench c,ient -- re

ate set:eth0 egress 100mbit ingress 100mbit
