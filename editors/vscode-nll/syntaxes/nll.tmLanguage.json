{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NLL",
  "scopeName": "source.nll",
  "fileTypes": [
    "nll"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nll",
          "match": "#.*$"
        },
        {
          "name": "comment.block.nll",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nll",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.other.interpolated.nll",
          "match": "\\$\\{[^}]+\\}"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nll",
          "match": "\\b(lab|node|link|network|profile|for|in|let|import|as|if|site|param|defaults|pool|validate|scenario|benchmark|for_each)\\b"
        },
        {
          "name": "keyword.other.nll",
          "match": "\\b(delay-correlation|loss-correlation|healthcheck-interval|healthcheck-timeout|host-reachable|vlan-filtering|latency-under|startup-delay|dns-resolves|description|healthcheck|tcp-connect|background|depends-on|entrypoint|interfaces|masquerade|passphrase|privileged|container|route-has|translate|wireguard|cap-drop|duplicate|duration|env-file|firewall|hostname|interval|no-reach|rate-cap|underlay|untagged|address|cap-add|channel|corrupt|default|forward|ingress|macvlan|members|mesh-id|overlay|reorder|retries|routing|runtime|samples|streams|timeout|version|volumes|workdir|accept|assert|author|config|egress|fwmark|icmpv6|impair|iperf3|ipvlan|jitter|labels|limit|listen|manual|memory|metric|parent|policy|prefix|reject|remote|spokes|subnet|sysctl|tagged|above|below|burst|clear|count|delay|dport|dummy|hosts|image|local|peers|reach|route|sport|state|table|vlans|vxlan|auto|dnat|down|drop|exec|icmp|ipv4|ipv6|loss|mark|mesh|mgmt|mode|ping|port|pull|pvid|rate|ring|snat|ssid|star|tags|type|vlan|wifi|wpa2|cmd|cpu|dev|dns|dst|env|hub|key|log|mtu|nat|off|run|src|tcp|udp|via|vni|vrf|at|ct|lo|to|up)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.cidr.nll",
          "match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+\\b"
        },
        {
          "name": "constant.numeric.ipv6-cidr.nll",
          "match": "[0-9a-fA-F]*:[0-9a-fA-F:]+/[0-9]+"
        },
        {
          "name": "constant.numeric.ipv6.nll",
          "match": "[0-9a-fA-F]*:[0-9a-fA-F:]+"
        },
        {
          "name": "constant.numeric.ip.nll",
          "match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.duration.nll",
          "match": "\\b[0-9]+(ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.rate.nll",
          "match": "\\b[0-9]+(kbit|mbit|gbit|kbps|mbps|gbps)\\b"
        },
        {
          "name": "constant.numeric.percent.nll",
          "match": "\\b[0-9]+(\\.[0-9]+)?%"
        },
        {
          "name": "constant.numeric.nll",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.link.nll",
          "match": "--"
        },
        {
          "name": "keyword.operator.directional.nll",
          "match": "->|<-"
        },
        {
          "name": "keyword.operator.range.nll",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.nll",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.nll",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.nll",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.nll",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.nll",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.list.begin.nll",
          "match": "\\["
        },
        {
          "name": "punctuation.section.list.end.nll",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.nll",
          "match": ":"
        }
      ]
    }
  }
}
