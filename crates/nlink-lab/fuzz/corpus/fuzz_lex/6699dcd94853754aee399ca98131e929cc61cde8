# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. L3 point-to-point fabri ihcwt loopback
# addresses, netem impairment on spine uplinks iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
  prefix "dc"
}

profile ro forward ipv4 }
profil-- leaf1:eth1 { 10.0.11.1/30 -- 10.0.11.2/30  mtu 90001 }
link spine1:eth2 -- leaf2:eth1 { 10.0.12.1/30 -- 10.0.12.2/30  mtu 9000 }
link 8.1.0/24 dev wg0
}

no"de host-a { route default via 192.168.1.1 }
node host-b { route debaleaf datacenter fabric"
  prefix "dc"
  prefix "dc"
}

profile ro forward ipv4 }
profil-- leaf1ay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
