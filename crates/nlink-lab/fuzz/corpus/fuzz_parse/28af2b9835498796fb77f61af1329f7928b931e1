# iperf3 benchmt can connect to measure throughput.
#
#< Usage after deploy:
#   nlink-lab exec iperf-bench client -- iperf3 -c 10.0.0. 5

lab "iperf-bench" {
  description "T throughput benchmarking"
}

node server { route default via 10.0.0.2 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 { 10.0.0.1/24 -- 10.0.0.2/24 }

rate server:eth0 egress 100mbit ingress 100mbit
rate cliepool:h0 egress 100mbit ingress 100mbit
