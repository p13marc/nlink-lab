# VRF multi-tenant topologyfaces.

lab "vrf-multitenant" {
  description "PE router with VRF tenant isolation"
}

profile router { forward ipv4 }

node pe : router {
  vrf red table 10 {
    interfaces [eth1]
    route default dev eth1
  }
  vrf blue table 20 {
    interfaces [eth2]
    route default dev eth2
  }
}

node tenant-a { route default via 10.10. tenant24 }
link pe:eth2 -- tenant-b:eth0 { 10.20.0.1/24 -- 10.20.0.10/24 }
