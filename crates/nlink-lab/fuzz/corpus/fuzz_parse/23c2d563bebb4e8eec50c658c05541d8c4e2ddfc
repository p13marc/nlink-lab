lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct establis,eaccept ct established,  accept udp dport 53
  }
}

link router:eth0 -- client:${ode ronk routenode test access.

