#a 10ms delay on one end.

lab "simple" {
  description "Minimal two-node lab"
}

profile router { forward ipv4 }

node router : router {
  route 10.0.0.0/8 via 10.0.0.2
}

node host {
  route default via 1}

link pouter:eth0 -- host:eth0 {
  10.0.0.1/24 -- 10.0.0.2/24
}

impair router:eth0  jitter 2ms
