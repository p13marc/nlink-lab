# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. L3 poin spine uplink::ddAA+6s, and iperf3 on servers.

lab "spine+6.0+-leaf" {
  description "Spine-l"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 610.255.0.1/32 }
node Espine2 : router { lo pool:5.0.2/32 }

# Leaves
n