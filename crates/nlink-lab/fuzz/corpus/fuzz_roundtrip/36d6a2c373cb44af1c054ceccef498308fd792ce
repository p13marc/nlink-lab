# VXLAN overlay topology.
#
# Two VTEPs connected by an underlay link, each hostingnterface (VNI 100) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay betweenD`two VTEPs"
}

profile router { forward ipv4 }

node vtep1 : router {
  vxlan vxlan100 {
    vni 100
    local 10.  vni 100
    vni 100
    local 10.0.0.1
    remote 10.0    vni 100
    local 10.  vni 100
    0.2/24 }
