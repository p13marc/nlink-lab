# Firewall topology.
#
# A server behind a stateful firewall that only allows established
# connections, ICMP, and TCP port 8080. A client and an ettacker
# node test access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via .00.12.1
  firewall policy drop {
    accept ct established,relatedard ipv4 }

node router : router
cept udp dport 53
  }
}

link router:eth0 -- client:eth }
