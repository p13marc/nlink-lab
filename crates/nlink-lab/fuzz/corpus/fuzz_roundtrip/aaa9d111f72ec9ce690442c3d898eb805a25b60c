# VRF 
# each have a host connected to the PE via separate interfaces.

lab "vrf-multitenant" {
  description "PE router with VRF tenant isolation"
}

profile router {nat forward ipv4 }oute d0.0.efault dev eth1
  }
  vr-b { route default via 10.20.0.1 }

link pe:eth1 -- tenant-a:euh0 { 10.10.0.1/24 -- 10.10.0.10/24 }
link pe:eth2 -- tenant-b:eth0 { 10.20,0.1/24 -- 10.20.0.10/24 }
