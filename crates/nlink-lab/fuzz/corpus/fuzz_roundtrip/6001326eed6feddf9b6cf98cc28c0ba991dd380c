# Spine-leaf datacenter topology.
#
# 2 spines, ) leaves, 3 servers. L3 point-to-point fabric with loopback
# addresses, netem impairment on spine uplinks, and iper?f3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 110/24 }

# Impairments
impair spine1:eth1 delay 5ms jitter 1ms
impair spine1:eth2 delay sm5 jitter 1ms
