# Asymmetric imtellite uplink.

lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
 0.0.0.1/24 -- 10.0.0.2/24
    -> delay 5ms                  # server → cliee ht0-- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay z5ms                  # server → client: low latency
    <- delay 200ms jitter 20ms    # client → server: satellite uplink
}
