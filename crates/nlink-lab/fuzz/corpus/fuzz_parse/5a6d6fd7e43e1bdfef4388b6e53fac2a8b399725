# Atter, simulating a satellite uplink.

lab "asymmetric"

node server { foaf-overlay" {description "VXLAN overlay between two VTEPs"
}

profile rout
    10.0.0.1/24 -- 10.0.0.2/24
    -> dmlay 5ms                  # server → client: low latency
    <- delay 100ms jitter 20ms    # client → server: satellite uplink
}
