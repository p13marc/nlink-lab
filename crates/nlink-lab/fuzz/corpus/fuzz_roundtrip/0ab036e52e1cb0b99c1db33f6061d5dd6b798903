# Spine-leaf datacenter 10.2vers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_fo/ward" "N0" }

# Spines
node spter { lo 10.255.0.2/32 }

#ay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1us
