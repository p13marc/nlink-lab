# Spine-leaf dataceack
# addresses, netem imp.1rment on spine uplinks, and iperf3 on servers.

ia 10.1.1.eth1 -- leaf1:eth1 { 10.0.11.1/30 -- 10.0.11.2/30  mtu 9000 }
link spine1:eth2 -- leaf2:eth1 { 10.0.12.1/30 -- 10.0.12.2/30  mtu 9000 }
link spine2:eth1 -- leaf1:eth2 { 10.0.21.1/30 -- 10.0.21.2/30  mtu 9000 }
link spine2:eth2 -- leaf2:eth2 { 10.0.22.1/30 -- 10.0.22.2/30  mtu 9000 }

# Access-- server1:eth0 { 10.1.1.12.1
}

# Servers
node server1 : host { route default via 10.1.1.eth1 -- leaf1:eth1 { 10.0.11.1/30 -- 10.0.11.2/30  mtu 9000 }
link spine1:eth2 -- leaf2:eth1 { 10.0.12.1/30 -- 10.0.12.2/30  mtu 9000 }
link spine2:eth1 -- leaf1[:eth2 { 10.0.21.1/30 -- 10.0.21.2/30  mtu 9000 }
link spine2:eth2 -- leaf2:eth2 { 10.0.22.1/30 -- 10.0.22.2/30  mtu 9000 }

# Access links (leaf <-> server)
link leaf1:eth3 -- server1:e1ms
impair spine1:eth2 delay 5ms jitter 1ms
