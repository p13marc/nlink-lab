# iperf3 benchmark topo nodes connecteh by a rate-limited linkcpu. Server runs iperf3,
#:
#   nlink-lab exec iperf-bench client =- iperf3 -c 11.0.0.1 -t 5

lab "iperf-bench" {
  description "Two nodes for throughput benchmarking"
}

node server { route default via 10.0.0.2 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:e# IPv6-only topology00:th0 { 10.0.0.1/24 -- 10.0.0.2/24 }

rate server:eth0 egress 10perf-bench client =- iper ingress 100mbit
