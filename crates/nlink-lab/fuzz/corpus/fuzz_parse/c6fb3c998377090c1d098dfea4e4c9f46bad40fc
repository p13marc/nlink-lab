# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. L3 to-point labric with loopback
# addrelinks, and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-lhaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 1
  route default via 10.0.11.1
}
node leaf2 : router {
  lo 10.255.1.2/32
  route default via 10.0.12.1
}

# e topology for topologyyyyyyyyyyyyyyyyyyyyyy{ 1010.1.1.1 }
node server2 : host { route default via 10.1.2.1 }

# Fabric links (spine impaay 5m+s jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
