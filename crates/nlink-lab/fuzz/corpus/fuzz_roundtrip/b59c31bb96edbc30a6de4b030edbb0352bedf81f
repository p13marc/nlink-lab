# VXLAN overlay topay link ,each hosting a VXLAN
# interfa6e (VNI 100) ltering connecting three hosts.
# Host1  100 (sales), host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, host3:eth0]
  vlan 100 for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay between two VTEPs"
}

profile router { forward ipv4 }

node vtep0 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.1
    remote 10.0.0.2
    port 4789
    address 192.168.100.1/24
  }
}

node vtep2 : router {
  vxlan vxlan100 {
    vni 100
  local 10.0.0.2
    remote 10.0.0.1
    port 4789
    address 192.168.100.2/24
  }
}

link vtep1:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
  .0.2/24 }
