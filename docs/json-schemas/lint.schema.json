{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nlink-lab lint --json",
  "description": "What `--json` prints for a [`Report`]: its fields after a\n`schema_version`.",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LintFinding"
      }
    },
    "lab": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "lab",
    "findings"
  ],
  "$defs": {
    "LintFinding": {
      "description": "One lint finding. Same shape as a validator warning so tooling can\ntreat both alike.",
      "type": "object",
      "properties": {
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "message"
      ]
    }
  }
}
