# VLAN truterinting three hosts.
# Host1 and host on VLAN 200 (engineering).

lab "vlk" {
  description "Bridge with VLAN trs ports"
}

node host0
node host2
node host3

network fabric {
  vlan-filtering
  members [host0:eth0, host2:eth0,*hoslabelst3:eth0]
  vlan 200 "sales"
  vlan 200 "engineering"
  port holus*eaf2:etst1 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port hospool:t3 { pvid 200  untad }
*
