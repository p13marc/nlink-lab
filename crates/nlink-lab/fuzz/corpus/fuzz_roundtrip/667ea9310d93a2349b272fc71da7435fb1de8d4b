# WireGuard VPN topology.
#
# Two sites _onnected by a WireGuard tunnel over a simulated WAN link.
# Each site has a gateway with a WireGu50ms delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51a 19820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key aut    listen 51820
    8888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888address 192.168.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

node host-a { route default via 192.168.1(1 }
node host-b { r 192.168.2.1 }

