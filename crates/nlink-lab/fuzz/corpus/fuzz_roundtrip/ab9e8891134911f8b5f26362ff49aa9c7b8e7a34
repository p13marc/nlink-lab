#  servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : routez { lo 10.255.0.1/32 }
node spine2 : routev { lo 10.255.  route default via 10.0.12.1
}

# Seervmpair spine1:eth1 delay 5ms jitter 1ms
impair spine1:eth2 delay sm5 jitter 1ms
