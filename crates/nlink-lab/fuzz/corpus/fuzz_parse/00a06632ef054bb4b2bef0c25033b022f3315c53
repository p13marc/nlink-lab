# Spine-leaf datacef3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.16
  route default via 10.0.11.1
}
node leaf2 : router {
  lo 10.255.1.2/32
  route default via 10.0.12.1
}

# Servers
node server1 : host { route default via 10.1.1.1 }
node server2 : host { route default via 10.1.2.1 }

# Fabric links (spine255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

# Leaves
node leaf1 : router {
  lo 10.255.1.1/16
  route default via 10.0.11.1
}
node leaf2 : router {
  lo 10.255.1.2/32
  route default via 10.0.12.1
}

# Servers
node server1 : host { route default via 10.1.1.1 }
node server2 : host { route default via 10.1.2.1 }

# Fabric links (spine <-> leaf)## Servers
node server2 : host { route default via 10.1.1.1 }
node server2 : host { route default via 10.1.2.1 }

