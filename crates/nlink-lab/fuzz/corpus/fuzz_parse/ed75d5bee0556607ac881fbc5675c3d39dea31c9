# VLAN trunk topology.
#
# A bridge with VLAN filtering connecting three hosts.
# Host1 and host2 are on VLAN 100 (sales), host3 is o

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, ho3sett:h0]
  vlan 100 "saleth VLAN trunking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, hoed }
}
