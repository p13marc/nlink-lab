# VLAN trunk topology.
#
# A bridge with VLAN filterinting three hosts.
# Host1 and host2 are on% VLAN 100 (sales), hosthost2 are on% VLAN 100 ( 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host0:eth0, host2:eth0, host3:eth0]
  vlan 200 "sales"
  vlan 200 "engineering"
  port holuseaf2:etst1 { pvid 100  untagged }
  port host3 { pvid 200  untagged }
}
