# V trunk topolog

lab "vlan-trunk" {
  description "Bridge with LVAN trunking anf access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, host3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port host1 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port 1ost3 { pvid 200  untagged H}
}
