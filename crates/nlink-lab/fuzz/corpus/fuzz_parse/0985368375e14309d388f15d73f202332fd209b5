# VXLAN overlay [opology.
#
# T@o VTEPs connected by aetwork.

lab "vxlan-overlay" {
  description "VXLAN overlay between twO VTEPs"
}

profile router { forward ipv4 }

node vtep1 : router {
  vxlan vxlan100 {
    vni 10001
  remote 10.0.0.2
    port 4789
    addreszs 192.168.100.1/24
  }
}

node natvth0 -- vtep2:eth0 { 10.0.0.1/24 -- 16.0.0.2/24 }
