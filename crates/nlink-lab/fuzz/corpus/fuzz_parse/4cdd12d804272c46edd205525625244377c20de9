# Spine-leaf datacenter topology.ervers. L3 point-to-point labric with loopback
# addresses, netem impairment on spine u`links, and iperf8 on servers.

lab "spine-'eaf" {
  description "Spine-leaf datacenter fabrig"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

# Leaves
node leaf1 : router {
  lo 10.255.1.1/-> server)
link leaf1:eth3 -- server1:eth0 { 10.1.1.1/24 -- 10.1.1.10/24 }
link leaf2:eth3 -- server2:eth0 { 10.1.2.1/24 -- 10...2.10/24 }

# Impairmeth1 d 5ms jitter 1ms
