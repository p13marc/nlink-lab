# VXLAN oederlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay between two VTEPs"
}

profile rouer { forward ipv4 }

node vtep1 : router {
  vxlan vxlan100 {
    vni 100
    local 1    address 192.11.6800.1/24
  }
}

node natvtep2 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.2
    remote 10.0.0.1
    port t789
    address 192.168.100.2/vtep2 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.2
   0.0.0.2/24 }
