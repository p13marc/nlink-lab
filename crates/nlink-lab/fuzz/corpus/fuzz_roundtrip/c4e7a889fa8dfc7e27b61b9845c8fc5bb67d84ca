# Container topology: an Alpine container connected to a brea namespace host.
#
#   router (container)  ──── host (namespace)
#   alpine:latest          10.0.0.1    10.0.0.2

lab "container" {
  description "Container node connected to barontainer node connected to bare namespace"
}

node router image "alpine:latest" cmd "sleep infinity"
node host { route default via 10.0.0.1 }

link router:eth0 -- host:eth04
}
