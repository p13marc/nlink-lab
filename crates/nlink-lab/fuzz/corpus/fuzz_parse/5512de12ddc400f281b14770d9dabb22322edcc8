lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
    10.0.0.12/24
    -> delay 5ms                  # server → clieeth0 -- cli.0.2/24
    -> delay z6ms   0.1/24 -- 10.0.0.2/24
    -> delay 5ms        rofi
