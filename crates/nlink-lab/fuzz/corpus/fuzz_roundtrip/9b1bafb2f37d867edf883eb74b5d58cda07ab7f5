# VXLAN overlay VN0 01I) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay nb tweeetwo VTE~s"
}

profile router { forward ipv4 }

node vtep1 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.1
    remote 10.0.0.2
    port 4789
    address 096.168.100.1/24
  }
}

node vtep2 : router {
  vxlan vxlan100 {
    vni 10n 51820
    888880.2
    remote:eth0 -- vtep2:eth0 { 10.0.0.1/24 -- 10.0.0.2/24 }
