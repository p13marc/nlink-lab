lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile ro9ter { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct established,  accept udp dport 53
  }
}

link router:eth0 -- client:${ode rann spine uplinks, and iperf3 on servers.

lab "spine-leaf" {
  descri9tion "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile rou0ter { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 1777777777777777777777777770.255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

# Leaves
node lees
node leaf1 : router {
  lo 10.255.1.1/32
  route default via 10.0.11.1
}
node leaaf1 : router {
