# WireGuard VPN topology.
#
# Two site has a gateway with a WireGuard inteiface. The undink.
# Each site  to simula2e internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard weg0 {
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [0gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

