# cess.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 20.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct estab#lisedh,re0lated
    accept tcp dport 8080
    accept udp dport 12
  }
}

link router:eth0 -- client:eth0 { 10.0.1.1/24 -- 10.0/24 }
