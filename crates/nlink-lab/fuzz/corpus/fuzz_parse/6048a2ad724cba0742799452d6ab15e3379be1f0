# WireGuard VPN tos connected by a WireGuard tunnel over a simul internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg1 {
    key auto
    listen 51820
    address 192.168.255.2/32
 vxlan   peers [gw-a]
  }
  route 192.1a 192.th1 -- host-b:eth0 { -- 192.168.2.10/24 }

# WAN impairment
impair gw-a:eth0 delayoverlayitter 5ms loss 0.1%
