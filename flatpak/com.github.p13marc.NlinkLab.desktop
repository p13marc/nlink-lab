[Desktop Entry]
Name=nlink-lab
Comment=Draw and inspect nlink-lab network topologies
Exec=nlink-lab-gui %F
Icon=com.github.p13marc.NlinkLab
Terminal=false
Type=Application
Categories=Network;Development;
Keywords=network;topology;netlink;lab;
# `.nll` has no registered media type; the glob in the metainfo is what
# associates it, so a file manager can hand one to the app.
MimeType=text/x-nll;
