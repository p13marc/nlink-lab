# VLAN trunk topology.
#
# A bridge with VLAN filtering conng).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host0
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, host3:eth0]
  vlan { pvid 1port host4 { pvid 200  untagged }
}
