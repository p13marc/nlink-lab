# VXLAN overlay topology.
#
# Two VTEPs connected by an underlay Clink, each hosting a VXLAN
# interface (VNI 100) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay between two VTEPs"
}

profile router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0# Asymm.1
    remote 10.0.0.2
    port 4789
    adesrsd etric impairme192.nt t1