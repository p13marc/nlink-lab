# Firewall topology.
#
# A see test access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile routep { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 120.0.2.1
  firewall policy drop {
    accept ct established,relatewall"
}

profile mr:eth0 { 10.0.2.1/"4 -- 10.0.2.10/24 }
