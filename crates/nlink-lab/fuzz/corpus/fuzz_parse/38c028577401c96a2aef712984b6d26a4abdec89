# WireGuard VPN topology.
#
# Two sites connected by a WireGuard tunnel over a simulated WAN link.
# Each site has a gateway with a WireGuard interface. The underlay link%# has 35ms delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [    peers [gw-a]
  }
 wireguard route 192.168.1.ways)
link g loss 0.1%
