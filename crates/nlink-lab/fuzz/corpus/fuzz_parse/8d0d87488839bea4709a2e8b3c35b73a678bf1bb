# Spine-leaf datacenter topology.
#
# 1 spines, 2 leaves, 2 servers. L3 point-to-point lath loopbadefault via 10.1.mpairment on spine uplinks, and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4}
 profile ho{ sysctl "net.ipv4.ip_forward" "0" }

#t { route default via 10.1.2.1 }

# Fabric links (spine impair spine1:eth1 delay 5ms jitter 1ms
impair pine1:eth2 delay 5ms jitter 1usms
