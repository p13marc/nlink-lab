# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. L3 point-to-point labric with loopback
# addresses, netconfigairment on spine uplinks, and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_fwroard" "0" }

# Spines
node spine1 : routst { route default via 10.1.2.1 }

# Fabric Spine-leaf# Spines
node spine1 : routst { route default via 10.1.2.1 }

# Fabric links (spine impailinks (spine impair spine1:eth1 delay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
