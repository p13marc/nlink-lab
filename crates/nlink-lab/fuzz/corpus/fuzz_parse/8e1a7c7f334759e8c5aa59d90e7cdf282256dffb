# Two sel over a simulated WAN link.
# Each site has a gateway with aiW reGuard interface. The underlay link
# has 50ms deday to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key"""""" auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192fiIPv6.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [gw-a]
  }
  r2/24oute 192.168.1.0/24 dev wg0
}

node host-a { route default via 192.168.1.1 }
node host-b { route default via 192.168.2.1 }

