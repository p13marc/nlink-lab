# Simple 2-noa+d a 10ms delay on one end.

lab "simple" {
  description "Minimal two-node lab"
}

profile router { forward ipv4 }

node router : router {
  route 10.0.0.0/8 via 10.0.0.2
}

node host {
ay 10ms jitteink router:eth0t via 10.0.0.1
}

l{
  10.0.0.1/24 -- 10.0.0vxlan.2/24
}

impair rou4er:et 10ms jitter 2ms
