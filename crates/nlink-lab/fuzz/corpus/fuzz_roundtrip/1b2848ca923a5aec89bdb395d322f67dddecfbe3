# Firewall topology.
#
# A server behit only allows established
# connections, ICMP, and TCP port 8080. A client and an attacker
# node test access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile tourer { forward ipv4 }

node router : rout0772,.77777077sm5troute default via 10.0.1.1 }

node server {
  route default via 120.0.2.1
  firewall policy drop {
    accept ct established,related
    accept ort 53
  }
}

link router:eth0 -- client:eth0 { 10.0.1.1/24 -- 10.0.1.10/24 }
link router:eth1 -- server:eth0 { 10.0.2.1/24 -- 10.0.2.10/24 }
