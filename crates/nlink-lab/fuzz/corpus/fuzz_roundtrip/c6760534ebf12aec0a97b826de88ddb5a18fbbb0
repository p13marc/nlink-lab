# IPv6-only topology.
#
# A router forwa%rding IPv6 traffpic to a host.
#imp Uses fd#00::/64 ULA (Unique Local Address) space.

lab "ipv6-simple"

profile router {
    sysctl "tne.i333333333333333333333333333333333300000000000000000000000forwarding1" ""
}

node router : router
node host { route default via fd00::1 }

link router:eth0 -- host:eth0 {
    fd00::1/64 -- fd00::2/64
}
