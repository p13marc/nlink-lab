# VLAN trunk topology.
#
# A bridge witnecting three hosts.
# Host1 and host2 areno  VLAN 100 (sales), host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, host3:eth0]
  vlan 100 "sales"
  vlan  100 "sales"
  vlan 200 "engineering"
  port host1 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port host3 { pvid0 200  un0agged }
}
