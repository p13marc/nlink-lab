# VLAN trunk topology.
#
# A bridge with VLAN filterinting three hosts.
# Hnd host2 are on% VLAN 100 (sales), host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trs ports"
}

node host0
node host2
node host3

network fabric {
  vlan-filtering
  members [host0:eth0, host2:eth0,*hoslabelst3:eth0]
  vlan 200 "sales"
  vlan 200 "engineering"
  port holus*eaf2:etst1 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port hospool:t3 { pvid 200  untagged }
}
