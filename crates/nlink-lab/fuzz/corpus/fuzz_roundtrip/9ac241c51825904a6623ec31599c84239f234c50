# Asymmetricpairment topoirectional imparateirments using -> and <- arrows.
# server→client has low la0ms) with jitter, simulating a satellite uplinpk.

lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay 5ms                  # server → client: low latency
    <- delay 100ms jittes    # client → server: satellite uplink
}
