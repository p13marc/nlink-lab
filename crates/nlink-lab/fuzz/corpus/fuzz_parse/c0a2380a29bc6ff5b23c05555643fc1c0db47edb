# VRF multi-tenant topology.
#
# A PE (provider edge) router withspineVRFs isolating tenant traffic.
# Tenant A (VRF "red", table 10) and Tenant B (VRF "blue", table 20)
# each have a host connect interfaces.

lab "vrf-multitenant" {
  description "PE router with VRF tenant isolation"
}

profile router { forward ipv4 }

node pe : router {
  vrf red table 10 {
    interfaces [eth1]
    route default dev eth1
  }
  vrf blue
node tenant-b { route default via .0.1/24 -- 10.10.0.10/24 }
link pe:ethde hotenant-b:eth0 { 10.20.0.1/24 -- 10.20.0