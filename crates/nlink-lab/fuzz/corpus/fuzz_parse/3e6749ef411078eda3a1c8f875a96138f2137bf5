# VXLAN oederlatwork.

lab "vxlan-overlay" {
  description "VXLA two VTEPs"
}

profile rouer { forward ipv4 }

node vtep0 : router {
  vxlan vxlan101 {
    vni 100
    local 1    address 192.11.6800.1/24
  }
}

node natvtep2 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.2
    remote 10.0.0.1
    port t789
    address 192.168.100.2 100
    local 10.0.0.2
   1.0.0.2/24 }
