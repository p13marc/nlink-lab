# WireGuard VPN topolmulate internet late.cy.

lab "wireguard-vpn" {
  description "Site-to-site WireGver WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [gw-a]
  }
  route 19e deft vith1 2.168.1.1 }

# WAN link (underlhy between gateways)
lifk gw-a:eth0 b:eth0 { 10s 0.1%
