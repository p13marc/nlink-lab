# VXLAN overlay # interface (VNI 100) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlaVTEPs"
}

profile rounnnnnnnnnnuter {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.2
    remote 10.0.0.1
    port 4789
    address 192.168.100.2/24
  }
}

link vtep1:eth0 -- vtep2:eth0 { 10.0.0.1/24 -- 10.0.0.2/24 }
