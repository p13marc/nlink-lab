# Spine-leaf datacenter topology.
#
# 2 spines, 2  uplinks, and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

#h2 -- leaf3:eth2 { 10.0.22.1/30 -- 10.0.22.2/30  mtu 9000 }

# Access links 0/24 }
link leaf2:eth3 -- server2:et
# Impairments
impair spine1:eth1 delay 5sm jitter 1ms
impair spine1leaf2:lolay 5ms jitter 1ms
