{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NLL",
  "scopeName": "source.nll",
  "fileTypes": [
    "nll"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nll",
          "match": "#.*$"
        },
        {
          "name": "comment.block.nll",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nll",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.other.interpolated.nll",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "include": "#strings"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nll",
          "match": "\\b(lab|node|link|network|profile|for|in|let|import|as|if|site|param|defaults|pool|validate|scenario|benchmark|for_each)\\b"
        },
        {
          "name": "keyword.other.nll",
          "match": "\\b(healthcheck-interval|healthcheck-timeout|delay-correlation|loss-correlation|host-reachable|vlan-filtering|latency-under|startup-delay|dns-resolves|fully-random|redistribute|allowed-ips|description|healthcheck|tcp-connect|background|depends-on|entrypoint|interfaces|masquerade|passphrase|persistent|privileged|container|direction|downdelay|duplicate|lacp-rate|min-links|partition|route-has|router-id|translate|wireguard|xmit-hash|addresses|cap-drop|classify|duration|endpoint|env-file|firewall|hostname|interval|neighbor|no-reach|peakrate|protocol|rate-cap|redirect|underlay|untagged|address|cap-add|channel|corrupt|counter|default|dynamic|forward|ingress|l4proto|macvlan|members|mesh-id|overlay|packets|passive|perturb|pkttype|quantum|reorder|restore|retries|routing|runtime|samples|streams|timeout|updelay|version|volumes|workdir|foreign|accept|assert|author|config|egress|fwmark|icmpv6|impair|iperf3|ipvlan|jitter|labels|listen|manual|memory|metric|miimon|output|parent|policy|prefix|random|reject|remote|replay|spokes|status|subnet|sysctl|tagged|target|manage|above|bands|below|burst|bytes|clamp|clear|count|delay|dport|dummy|flags|flows|group|hello|hosts|image|input|level|limit|local|noecn|peers|qdisc|reach|route|sport|state|table|vlans|vxlan|netns|area|auto|bond|both|dead|dnat|down|drop|exec|heal|icmp|ipv4|ipv6|keep|loop|loss|mark|mesh|mgmt|mode|name|ospf|over|peer|ping|pmtu|port|pull|pvid|rate|ring|save|seed|size|snat|ssid|star|step|tags|type|vlan|wifi|with|wpa2|zone|kind|bgp|cmd|cpu|dev|dir|dns|dst|ecn|env|frr|hub|iif|key|log|mss|mtu|nat|off|oif|rpf|run|set|src|tcp|udp|via|vni|vrf|tap|at|ct|id|lo|to|up|tc)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.cidr.nll",
          "match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+\\b"
        },
        {
          "name": "constant.numeric.ipv6-cidr.nll",
          "match": "[0-9a-fA-F]*:[0-9a-fA-F:]+/[0-9]+"
        },
        {
          "name": "constant.numeric.ipv6.nll",
          "match": "[0-9a-fA-F]*:[0-9a-fA-F:]+"
        },
        {
          "name": "constant.numeric.ip.nll",
          "match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.duration.nll",
          "match": "\\b[0-9]+(ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.rate.nll",
          "match": "\\b[0-9]+(kbit|mbit|gbit|kbps|mbps|gbps)\\b"
        },
        {
          "name": "constant.numeric.percent.nll",
          "match": "\\b[0-9]+(\\.[0-9]+)?%"
        },
        {
          "name": "constant.numeric.nll",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.link.nll",
          "match": "--"
        },
        {
          "name": "keyword.operator.directional.nll",
          "match": "->|<-"
        },
        {
          "name": "keyword.operator.range.nll",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.nll",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.nll",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.nll",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.nll",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.nll",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.list.begin.nll",
          "match": "\\["
        },
        {
          "name": "punctuation.section.list.end.nll",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.nll",
          "match": ":"
        }
      ]
    }
  }
}
