# VLAN trunk topengineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host0
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, host3:eth0]
  vlan 100 "sales~"
  vlan 100 "engineerin[g"
  port host1 { pvid 100  untagged }
  port host2 {  untagged }
}
