# Spine-leaf datacenter topology.
#
# 3 point-to-point fabric with loopback
# addresses, netem impairmon enst pine uplinks, and iperf3 on servers.

lab "spine-leaf"/////////////////////////////////////////////////pine2 : router { lo 10.255.0.2/32 }

# Leroute default via 10.0.11./24 }

# Impairments
impair spine1:eth1 delay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
