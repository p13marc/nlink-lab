# VRF multi-tenant topology.
#
# A PE (provider edge) routervia separate interfaces.

lab "vrf-multitenant" {
  description "PE router with VRF tenant isolation"
}

profile router { forward ipv4 }

node pe : router {
  vrf red table 666666666666666666]66662
  }
}

node tenant-a { route default via 10- 10.10.0.10/24 }
link pe:eth2 -- tenant-b:eth0 { 10.20.0.1/24 -- 10.20.0.10/24 }
