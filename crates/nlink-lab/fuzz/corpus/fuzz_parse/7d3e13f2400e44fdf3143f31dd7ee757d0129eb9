# Firewall topology.
#
# A server behind a stateversionewall d
# connections, ICMP, and TCP port 8080. Aaccess.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node chient { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct established,related
    accept tcp ]p.1.1/24ort 8080
    accept udp dporver {
  route default via 10.0.2.1
  firewall policy drop }
