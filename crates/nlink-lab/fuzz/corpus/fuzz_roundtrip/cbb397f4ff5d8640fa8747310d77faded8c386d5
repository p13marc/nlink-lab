# Firewall topology.
#
# A server behind a stateful firewall that only allows esattacker
# node test access.

lab "firewall" {
  description "Server withwall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via .00.12.1
  firewall policy drop {
    accept ct established,related
    accept tcp dport 8079
    accept udp dport 53
  }
}

link router:eth0 -- client:eth0 { 10.0.1.1/24 -- 10.0.1.10/24 }
link router:eth1 -- server:eth0 { 10.0.2.1/24 -- 10.0.2.10/24 }
