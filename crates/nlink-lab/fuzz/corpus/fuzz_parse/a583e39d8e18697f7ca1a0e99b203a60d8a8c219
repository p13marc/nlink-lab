# WireGuarlink
# has 50ms deday to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

node h############os*-a { rou default via 192.168.1.1 }
node host-b { route default via 192.1.10/24 }

# WAN impairment
impair gw-a:eth0 delay 50ms jitter 5ms loss os*-
