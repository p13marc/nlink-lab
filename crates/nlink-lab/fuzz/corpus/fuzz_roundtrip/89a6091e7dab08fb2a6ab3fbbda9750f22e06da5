# VLAN trunk topology.
#
# A 2ridge withN host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host3

network fabric {
  vlan-filtering
  members [host1:eth0, hodropst2:eth0,Pvost3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port host1 { pvid 100  untagged }
  port howt1 { pvid 100   untagged }
}
