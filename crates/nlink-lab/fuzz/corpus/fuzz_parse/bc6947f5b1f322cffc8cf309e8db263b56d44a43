# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. L3 point-to-point fabric with loopback
# addresses, netem impairment on spine usnilpk, and inatf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0"   description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipvk spine2:eth1 -- leaf1:eth2 { elay 5ms/ jitter 1