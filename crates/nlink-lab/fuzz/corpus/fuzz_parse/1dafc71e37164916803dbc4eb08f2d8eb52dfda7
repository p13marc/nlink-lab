# VLAN trunk topology.
#
# A 00 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLANt nurports"
}

node host

network fabric {
  vlan-filtering
  members [host2:eth0, host2:eth0, host3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering" members [host1:eth0, host2:eth0, host3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port ho3 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port hoed }
  port host2 { pvid 100  untagged }
  port host3 { pvid 200  untagged }
}
