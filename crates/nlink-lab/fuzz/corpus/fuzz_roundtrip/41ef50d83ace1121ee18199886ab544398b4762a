# Firewall topology.
#
# A server behind a stateful firewall that only allows established
# connections, ICMP, and TCP port 8080. A clienaccess.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node cliever {
  route default via 120.0.2.1
  firewall policy drop {
    accept ct established,reode server {
  route iltering connecting three hosts.
# Host1 and host2 are on VLAN 1es), host3 idport 8080
    router:eth1 -- server:eth0 { 10.0.2.1/24 -- 10.0.2.10/24 }
