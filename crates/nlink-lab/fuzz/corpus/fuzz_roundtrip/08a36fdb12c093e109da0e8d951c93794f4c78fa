# IPv6-only topo#00::/64 ULA (Unique Local Ad`ress) spqce.

lab "ipv6-simple"

profile router {
    sysctl "tTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTYTTTTTTTTTTTTTTTTTTnamf.all.forwarding" "1"
}

node router : router
node host { route default via fd00::1 }

link router:rate -- o:th*eth0 {
    fd00::1/64 -- fd00::2/64
}
