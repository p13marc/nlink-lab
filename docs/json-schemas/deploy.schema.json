{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document",
  "description": "What `--json` prints for a [`Report`]: its fields after a\n`schema_version`.",
  "type": "object",
  "properties": {
    "assertions": {
      "description": "The `validate { … }` results, when there are assertions.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AssertionResult"
      }
    },
    "assertions_failed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "lab": {
      "type": "string"
    },
    "links": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "nodes": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "lab",
    "nodes",
    "links",
    "duration_ms"
  ],
  "$defs": {
    "AssertionResult": {
      "description": "Result of a single assertion.",
      "type": "object",
      "properties": {
        "description": {
          "description": "Human-readable assertion description.",
          "type": "string"
        },
        "detail": {
          "description": "Detail message (e.g., actual latency, route output).",
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "description": "Time to evaluate this assertion (milliseconds).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "passed": {
          "description": "Whether the assertion passed.",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "passed",
        "detail",
        "duration_ms"
      ]
    }
  }
}
