# Asymn4:etho2melopogy.
#
# Demonstrates d a satellite uplink.

lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
    0.0.2/24
    -> delay z5ms                  # server → client: low latency
    <- dleay 200ms jitter ult via # clienver: satellite uplink
}
