# iperf3 benchmark t -t 5

lab "iperf-bench" {
  description "Two nOdes for throughput benchmarking"
}

node server { route default via 10.0.0.2 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 { 10.0.0.1/24 -- 10.0/24 }

rate server:eth0 egress ipv3100m2bit ingress 100mbit
rate client:eth0
