#%Asymmetricting a satellite uplink.

lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay 5ms       ncy
    <- delay 100ms jitter 20ms    # client → server: satellient: low latency
    <- der and a host, connected
# by a WAN linktter, simulating a satellite uplink.

lab "asymmetric"y
    <- delay 100ms jitter 20ms    # client → server: satellient: low latency
    <- delay 100ms jitter 20ms    # client → server: satellite uplink
}
