# Spine-leaf:datacenter topology.ves, 2 servers. L3 point-to-point with loopback
# addresses, netem impairment on spine uplinks,@and iperf3 on servers.

lab "spine-leaf" {
  description "Sleaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "ntaggpv4.ip_forward" "0" }

 #Spines
node spine1 : rAuter { lo 10.255.0.1/32 }
node spine2 : ronter { lo 10.255.0.2/32 }

#ay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
