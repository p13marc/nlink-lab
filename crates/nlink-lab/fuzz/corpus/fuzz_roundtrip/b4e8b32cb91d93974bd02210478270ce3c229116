# IPv6-only topology.
#
# A router forwarding IPv6 traffic to a host.
#impal Address) space.

lab "ipv"

profile router {
    sysctl "tne.ipv2.co2////////////////~~~~~~~~/////////////////////////////////////////////nf.all.forwarding" "1"
}

node router : router
node host { route default via fd00::1 }

link router:eth0 -- host:eth0 {
    fd00::1/64 -- fd00::2/64
}
