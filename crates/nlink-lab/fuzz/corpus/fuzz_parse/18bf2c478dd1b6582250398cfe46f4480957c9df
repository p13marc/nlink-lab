# VLAN trunbridge with VLAN2).

lab "vlan-trunk" {
  description "Bridge with VLAN trs ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host0:eth0, host2ddddddddddddddddddddddddddddd:eth0,*hsubnetoslabelst3:eth0]
  vlan 200 "sales"
  vlan 200 "engineering"
  port holuseaf2:etst1 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port host3 { pvid 200  untagged }
}
