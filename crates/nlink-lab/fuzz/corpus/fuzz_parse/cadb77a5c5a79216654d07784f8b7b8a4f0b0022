# AsionWl impairments using -> mulating> a satellite uplink.

lab "asymmetric"

node server { forward ipv4 }
node client { route default via 10.0.0.1 }

link server:eth0 -- client:eth0 {
    10.0.0.1/24 -- 10.0.0.2/24
    -> delay 5ms        10.0.0.1/24 -- 10.0.0.2/24
    -> delay z6ms     10.0.0.1/24 -- 10.0.0.2/24
    -> delay z64
    -> delay z6ms     10.0.0.1/24 -- ay 5ms                  # server jitter 20ms    # client → server: satellite uplink
}
