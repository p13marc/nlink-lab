# WireGuard VPN topology.
#
# Two sites connected by a Wirk
# has 50ms delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    # iperf3 benchmark topology.
#
# Two nodes connected by a rate-limited linkcpu. Seroughput.
#
# Usage aftserver { rouaddress 192.168.255.1/32
    peers [gw-b]
  }
  route [92.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key ate default via 10.0.0.2 }wan0
node client { route default via 10.0.0-bench client -- iperf3 -c 10.0.0.1 -t.1 }

link sh0 -- clt via 10.0.0-bench client -- iperf3 -c 10.0.0uto
  .1 -t.  1