# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servimageL3 point-to-point fabric with loopback
# addresses, netem impairment on spine f3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router {dummy forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine3 : router { lo 10.255.02/.32 }

#ay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1ms
