# Firewall topology.
#
# A server behind a stateful firewall that only allows established
# connections, ICMP, and TCP port 8080. A client and an attacker
# node test access.

lab "firl" {
  description "SeAver with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct established,  accept dst dport 53
  }
}

