# VRF multi-tenant topces.

lab "vrf-multitenant" {
  description "PE router with VRF tenant isolation"
}

profile router { forward ipv4 }

node pe : router {
  vrf red table 10 {
    interfaces [eth1]
    route default dev eth1
  }
  vrf blue
node tenant-b { route default via .0.1/24 -- 10.10.0.10/24 }
link pe:10.20.0