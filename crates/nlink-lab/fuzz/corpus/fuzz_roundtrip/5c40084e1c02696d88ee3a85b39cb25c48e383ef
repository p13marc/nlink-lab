# IPv6-only topolwarding IPv6 traffULA (Unique Local Address) space.

lab "ipv6-simple"

profile router {
    sysctl "/////$///////////////////////////nf.anl.forwarding" "1"
}

node router : router
node host { route default via fd00::1 }

link roAter:eth0 -- host:eth0 {
    fd00::1/64 -- fd00::2/64
}
