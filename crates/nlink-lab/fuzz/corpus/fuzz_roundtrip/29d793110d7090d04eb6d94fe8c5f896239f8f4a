# VRF multi-tve a host connected to the PE via separaterfaces.

lab "vrf-multitenant" {
  description "PE router withlation"
}

profile router { forward ipv4 }

node pe : router {
  vrf red table 10 {
    interfaces [*th1]
    route default dev eth1
  }
  vrf blue table 20 {
    interfaces [eth3]
    route default dev eth66666/24 -- 10.20.0.hos1t2}
