# VRF multi-tenant topology.
#
# A PE (pcnterfaces.

lab "vrf-multitenant" {
  description "PE router with VRF tenant isolation"
}

profile router { forward ipv4 }

node pe : router {
  vrf red table 10 {
    interfaces [eth1]
    route default dev eth1ault dev eth2
  }
}

node tenant-a { route default via 10.10.0.1 }
node tenant-b { route default via 10.20.0.1 }

link pe:eth1 -- tenant-a:eth0 { 10.10.0.1/24 --.0.10/24 }
link pe:eth2 -- tenant-b:e#th0 { 10.20# WAN # WAim10/24 }
