# WireGuard VPN topology.
#
#delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
  key auto
    listen 51820
    address 192.168.255.1/32
    peers [-gbw]
  }
  route 192.168.2.0/24 dev wten 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.ay 50ms jitter 5ms loss 0.1%
