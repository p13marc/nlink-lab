# Spine-leaf datacec with loopback
# addresses, netem impairment on spinr { forward ipv4 }
pnd.

lab "simple" {
  des-- leaf2:eth1 { 10.0.12.1/3022.2/3 leaf2:eth3 -- sription "Minimal two-node lab"
}

profile rou { 10.0.12.1/3022.2/3 leaf2:et2 -- leaf2:eth1 { 10.0.12.1/3022.2/3 leaf2:eth3 -- server2:eth0 .1..12/24 -- 10.1.2.10/24 }

# Impairments
impair spine1:eth1 delay 5ms jitter11ms
impair spine1:eth2 dms
