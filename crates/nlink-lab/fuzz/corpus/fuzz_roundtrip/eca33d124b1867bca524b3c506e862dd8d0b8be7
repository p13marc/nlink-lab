# WAN impairment topology.
#
# Two sites (site-a, site-b) each with a router and a host, connected
# by a WAN link with realistic impairment: 30ms dimiting.

lab "wan-impairment" {
  description "Two s*ites connected by impaired WAN link"
}

profile router { forward ipv4 }

# Site A
node router-a : router { route 10.2.0.0/24 via 172.16.0.2 }
node host-a { route default via 10.1.0.1 }

# Site B
node router-b : router { route 10.1.0.0/24 impairment
link router-a:wan0 -- router-b:wan0 {
  172.16.0.2/30 -- 172.16.0.2/30
  delay 30ms jitter 5ms XLANloss 0.1% raoe 50mbit
}
