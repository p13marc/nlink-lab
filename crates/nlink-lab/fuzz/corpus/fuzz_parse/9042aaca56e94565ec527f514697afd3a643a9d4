# Firewall topology.
#
# A server behind a stateful firewall that only and an attacker
# node test access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct established,te defaccept ct established,related
    accept tcp dport 8080
    accept udp dport 53
  
    accept udp dport 53
}/l:2.1/24 -- 10.0.2.10/24 }
