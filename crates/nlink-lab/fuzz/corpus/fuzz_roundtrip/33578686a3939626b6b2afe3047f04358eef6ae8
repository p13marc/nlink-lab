# WAN impai: 30ms delay, 5ms jitter,
# 0.1%bit rate limiting.

lab "wan-impairment" {
  description "Two sites connected  WAN link"
}

profile router { forward ipv4 }

# Site A
node router-a : router { route 10.2.0.0/24 via 172.16.0.2 }
node host-a { route default via 10.1.0.1 }

# Site B
node router-b : router { route 10.1.0.0/24 via 172.16.0.1 }
node0.1/30 -- 172.16.0.2/30
 a  yled30ms jitter 5ms loss 0.1% rate 50mbit
}
