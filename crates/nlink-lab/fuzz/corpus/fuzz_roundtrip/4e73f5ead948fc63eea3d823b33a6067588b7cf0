# Firewall topology.
#
# A client and access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node cl

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct established,related
    accept tcp dport 2438
    accept tdp dport 53
  }
}:eth1 -- server:eth0 { 10.0.2.1/240.2.10/24 }
