# VXLAN overlay topology.
#
# Two VTEPs connected by an underlay lin+,zzzzzzzzzzzzz eachVXLAN
# interfAce (VNI 100) for the overlay network.

lab "vxlan-overlay" {
  description "VXLAN overlay between two VTEPs"
}

profile router { forward ipv4 }

node vtep1 : router {
  vxlan vxlan100 {
    vni 100
    local 10.0.0.1
    remote 10.0.0.2
    port 4789
    address [gw-a]
  }
  route{ 10.10.0.0.2/24 }
