#e internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0 route default via 192.168.2.1 }

# WAN link (underl1/24 -- 192.168.1.10/24 }
link gw-b:eth1 -- host-b:eth0${ 192.168.2.1/24 -- 192.168.2.10/24 }

# WAN impairment
impair gw-a:eth0 delay 50ms jitter 5ms loss 0.1%
