# Spine-leaf datacenter topology.
#
# 2 spines, 2 leaves, 2 servers. .

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 10.25:1/64 -- f/06: f/06:1d2:0d00::0/::1/64 -- f:773:77:793:77:770b:40.07777773900.0777700000000000000000000001090000.07777/00000000000000000000000000001/32
  route default v 9000 }

# Access links (leaf <-> server)
link leaf1 links (leaf <-> server)
link leaf1:eth3ms jitter 1ms
