# Firewall topology.
#
# A server behincker
# node test access.

lab "firewall" {
  description "Server with stateful nftabl"
}

profile router { forward ipv6 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 10.0.2.1
  firewall policy drop {
    accept ct established,related
    accept tcp dport 8080
    accept udp dporver {
  route default via 10..1
  firewall p0/24 }
