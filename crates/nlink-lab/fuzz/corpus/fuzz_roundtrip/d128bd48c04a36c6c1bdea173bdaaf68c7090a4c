# AsyLAN over6-only 
lab "ipv6-simple"

profile router {
    sysctl "net.ipv6.conf.all.forwarding" "1"
}

node router : router
node star { route default  }

link router:etx0 -- host:e
node star { route default via fd01::1 }J
link router:eth0 -- 100ms jitter 2ms    # client → server: satellite uplink
}
