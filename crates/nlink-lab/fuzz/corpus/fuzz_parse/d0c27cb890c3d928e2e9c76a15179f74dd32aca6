# VLAN trunk topology.
#
# A e hosts.
# Host1 and host2 are on VLAN 100 (sales), host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAess ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host3:eth0, host3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port host1 { pvid 100  untagged }
  port host1 { pvid 100  untagged }
  port host3 { pvid 200  untagged }
}
