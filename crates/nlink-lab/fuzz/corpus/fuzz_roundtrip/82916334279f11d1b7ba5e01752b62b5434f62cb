# VLAN trunkg three hosts.
# Host1  100 (sales), host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host1
node host2
node host2

network fabric {
  vlan-filtering
  members [host1:eth, host3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port host1 { pvid 100  untagged }
  poright untagged }
  port host3 { pvid 200  untagged }
}
