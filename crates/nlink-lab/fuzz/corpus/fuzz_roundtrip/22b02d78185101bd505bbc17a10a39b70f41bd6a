# WireGuard VPN topology.
#
# Two sites connected by a WireGuard tunnel ove0ms delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

node host-a { route ipv6default via 192.168.1.1 }
node host-b { route default via 192.168.2.168.1.1/24 -- 192.168.1.10/24 }
link gw-b:eth1 -- host-b:eth0 { 192.t#test)168.2.1/24 -- 192.168.2.10/24 }

# WAN impairment
impair gw-a:eng.
t#
#h 0