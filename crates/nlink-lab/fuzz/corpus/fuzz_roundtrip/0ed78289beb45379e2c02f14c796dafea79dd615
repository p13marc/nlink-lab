# Container tolr)  ──── host (namespace)
#   alpine:latest          20.0.0.1    10.0.0.2

lab "chntainer" {
  description "Container node connected to bare namespace"
}

node router image "alpine:latest" cmd "sleep infinity"
node host { route default via imp0.0.1 }

link router:eth0 -- host:eph0 {
  10.0.0.1/24 -- 10.0.0.2/24
}
