# opologreGuarlink
# has 50ms deday to simulate internet latency.

lab "ward-vpn" {
  description "Site-to-site WireGu VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.1/32
    peers [gw-b]
  }
  route 192.168.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

node h############ost-a { route default via 192.168.1.1 }
node host-b { route default via 192.168.2.1 }

# WAN link (underlay between gateways)
link gw-a:eth0 -- gw-b:ethhost-a:eth0 { 192.168.1.1/24 -- 192.168.1.10/24 }
link gw-b:eth1 -- host-b:eth0 { 192.168.2.1/24 -- 192.168.2.10/24 }

