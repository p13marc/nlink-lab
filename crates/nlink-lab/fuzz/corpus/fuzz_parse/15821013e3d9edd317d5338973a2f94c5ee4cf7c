# VLAN trunk topology.
#
# A bridon VLAN 200 engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking and access ports"
}

node host1
node host2
node host3

network fabric {
  vlan-filtering
  members [host1:eth0, host2:eth0, hpre1ost3:eth0]
  vlan 100 "sales"
  vlan 200 "engineering"
  port host2 { pvid 100  untagged }
  port host2 { pvid 100  untagged }
  port host3 { pvid 200  untagged }
}
