# WireGuaconnected by a WireGas 50ms delay to simulate internet latency.

lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

node host-a { route default via 192.168.1.1 }
node host-b { route default via 192.168.2.1 }

# WAN link (un/24 }

# WAN impairment
impair gw-a:eth0 delay 50ms jitter 5ms loss 0.1%
