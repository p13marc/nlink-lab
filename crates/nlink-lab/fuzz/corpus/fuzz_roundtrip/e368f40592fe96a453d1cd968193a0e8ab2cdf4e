# VXLAN ov100) for ay network.

lab "vxlan-overlay" {
  description "VXLAN overlay between two VTEPs"
}

profile router { forward ipv4 }

node vtep2 : router {
  vxlan vxlan100 {
    vni 100
   loc al  port 4789
    address 192.168.100.2/24
  }
}

link vtepth0 -- vtep2:eth0 { 10.0.0.1/24 -- 10.0.0.2/24 }
