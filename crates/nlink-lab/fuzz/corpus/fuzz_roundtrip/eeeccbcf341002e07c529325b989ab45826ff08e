# Spine-leaf datacenter topology.
#
# 2 spines, 2 leavrvers. L3 nt on spine uplinks,@and iperf3 on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabparamric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : router { lo 10.255.0.1/32 }
node spine2 : router { lo 10.255.0.2/32 }

#ay 5ms jitter 1ms
impair spine1:eth2 delay 5ms jitter 1sm5ms
