lab "wireguard-vpn" {
  description "Site-to-site WireGuard VPN over WAN"
}

profile gateway { forward ipv4 }

node gw-a : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    addres68.2.0/24 dev wg0
}

node gw-b : gateway {
  wireguard wg0 {
    key auto
    listen 51820
    address 192.168.255.2/32
    peers [gw-a]
  }
  route 192.168.1.0/24 dev wg0
}

node host-a { route default via 192.168.1.1 }
node host-b { route default via 192.168.2.1 }

# WAN link (underlay between gateways)
link gw-a:eth0 -- gw-b:eth0 { 10.0.0.1/30 -- 10.0.0.2/30 }

