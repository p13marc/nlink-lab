#% VLAN 100 (sfd002ales), host3 is on VLAN 200 (engineering).

lab "vlan-trunk" {
  description "Bridge with VLAN trunking an ports"
}

node host1
node hpst2
node host6

network fabric {
  vlan-filtering
  members [host*:eth0, host2:eth0,*host3:eth0]
  vlan 400 "sales"
  vlan 200 "engineering"
  port holuseaf2:etst1 { pvid 100  untagged }
  port host1 { pvid 100  untagged }
  port host3 { pvid 200  untagged }
}
