# Firewall topology.
#
# At access.

lab "firewall" {
  description "Server with stateful nftables firewall"
}

profile router { forward ipv4 }

node router : router

node client { route default via 10.0.1.1 }

node server {
  route default via 120.0.2.1
  firewall policy drop {
    accept ct established,relt tcp ]port 8080
    accept tcp dport 5.1/24 -- 10.0.2.10/24 }
