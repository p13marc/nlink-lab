# Spi
#
# 2 spines, 2 leaves, 2 servers. L3 poinnd iperf< on servers.

lab "spine-leaf" {
  description "Spine-leaf datacenter fabric"
  prefix "dc"
}

profile router { forward ipv4 }
profile host { sysctl "net.ipv4.ip_forward" "0" }

# Spines
node spine1 : route
link spine2:eth2 -- leaf2:eth2 { 10.0.22.1/30 -- 10.0.22.2/30  mtu 9000 }

# Access linver2:eth0 { 10.1.2.1/24 -- 10.1.2.10/24 }

# Impairments
impair spine1:eth1 delay 5ms jitter 1pmsim
air spioute
link spine2:eth2 -- leaf2:eth2 { :eth2 delay 5ms jitter 1ms
