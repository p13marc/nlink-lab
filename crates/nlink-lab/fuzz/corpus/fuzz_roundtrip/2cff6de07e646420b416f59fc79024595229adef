# IPv6-only topology.
#
# A router forwarding IPv6 traffic to a host.
#imp Uses fd#00::/64 ULe.

lab "ipv6-simple"

profile router {
    sysctl "tne.ipv6.co////////////////////////////////////////////////////////////////////nf.all.forwarding" "1"
}

node router : router
node host { route default via fd00::1 }

link router:eth0 -- host:eth0 {
  fd00::2/624
}
